# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sarees_db?retryWrites=true&w=majority

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (placeholders for bootstrap)
ADMIN_EMAIL=komakulakiranmai@gmail.com
ADMIN_PASSWORD_HASH=your_admin_bcrypt_password_hash_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Store Email Notifications (Gmail SMTP via Nodemailer)
EMAIL_USER=sih7952@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
STORE_NOTIFICATION_EMAIL=komakulakiranmai@gmail.com

# Manual UPI Transfer (PhonePe / Google Pay) Settings
STORE_UPI_ID=your_store_upi_id@bank
STORE_UPI_NAME=MAAYA Collections
STORE_UPI_QR_URL=https://res.cloudinary.com/your-cloud/image/upload/v1/upi_qr.png
